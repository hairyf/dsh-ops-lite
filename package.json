{
  "name": "dsh-ops-lite",
  "type": "module",
  "version": "0.1.2",
  "packageManager": "pnpm@11.15.1",
  "description": "Maintained dsh-ops fork with native file tools, Bash, background jobs and PTC",
  "author": "Hairy <wwu710632@gmail.com>",
  "license": "MIT AND Apache-2.0",
  "homepage": "https://github.com/hairyf/dsh-ops-lite#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hairyf/dsh-ops-lite.git"
  },
  "bugs": "https://github.com/hairyf/dsh-ops-lite/issues",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "operations"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./shell": "./dist/shell.js",
    "./file": "./dist/index.js",
    "./background": "./dist/background.js",
    "./ptc": "./dist/ptc.js",
    "./locale/*.json": "./dist/components/file/locale/*.json",
    "./icon": "./dist/components/icon.png",
    "./shell/locale/*.json": "./dist/components/shell/locale/*.json",
    "./file/locale/*.json": "./dist/components/file/locale/*.json",
    "./background/locale/*.json": "./dist/components/background/locale/*.json",
    "./ptc/locale/*.json": "./dist/components/ptc/locale/*.json",
    "./shell/icon": "./dist/components/icon.png",
    "./file/icon": "./dist/components/icon.png",
    "./background/icon": "./dist/components/icon.png",
    "./ptc/icon": "./dist/components/icon.png",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "README.md",
    "cordis.patch.yml",
    "dist/*.d.ts",
    "dist/*.js",
    "dist/*.map",
    "dist/components",
    "dist/prepare-workspace.ps1"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint",
    "prepack": "pnpm run build",
    "release": "node node_modules/bumpp/bin/bumpp.mjs",
    "start": "tsx src/index.ts",
    "test": "pnpm run build && vitest",
    "test:e2e": "node test/e2e/run.mjs",
    "typecheck": "tsc",
    "hooks": "git config core.hooksPath .githooks && simple-git-hooks"
  },
  "scripts-info": {
    "build": "Build the library for publishing",
    "dev": "Rebuild on change during development",
    "lint": "Check for code style issues",
    "prepack": "Build before publishing",
    "release": "Bump version and publish a release",
    "start": "Run the entry file",
    "test": "Run the test suite",
    "typecheck": "Check types",
    "hooks": "Set up development git hooks"
  },
  "optionalDependencies": {
    "@dshopslite/darwin-arm64": "workspace:*",
    "@dshopslite/linux-x64": "workspace:*",
    "@dshopslite/win32-x64": "workspace:*"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:cli",
    "@antfu/ni": "catalog:cli",
    "@antfu/utils": "catalog:inlined",
    "@deepseek-ai/cordis": "catalog:dsh",
    "@deepseek-ai/cordis-plugin-group": "catalog:dsh",
    "@deepseek-ai/cordis-plugin-include": "catalog:dsh",
    "@deepseek-ai/cordis-plugin-loader": "catalog:dsh",
    "@deepseek-ai/dsh-agent": "catalog:dsh",
    "@deepseek-ai/dsh-agent-default-model": "catalog:dsh",
    "@deepseek-ai/dsh-agent-loop": "catalog:dsh",
    "@deepseek-ai/dsh-agent-preset": "catalog:dsh",
    "@deepseek-ai/dsh-agent-preset-registry": "catalog:dsh",
    "@deepseek-ai/dsh-api-session-controller": "catalog:dsh",
    "@deepseek-ai/dsh-api-workspace-controller": "catalog:dsh",
    "@deepseek-ai/dsh-client-connection": "catalog:dsh",
    "@deepseek-ai/dsh-client-locale": "catalog:dsh",
    "@deepseek-ai/dsh-client-store": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-conversation": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-layout": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "catalog:",
    "@deepseek-ai/dsh-client-ui-primitives": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-session": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-settings": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-theme": "catalog:dsh",
    "@deepseek-ai/dsh-client-ui-workspace": "catalog:dsh",
    "@deepseek-ai/dsh-host-webserver": "catalog:dsh",
    "@deepseek-ai/dsh-llm": "catalog:dsh",
    "@deepseek-ai/dsh-permission-presets": "catalog:dsh",
    "@deepseek-ai/dsh-session": "catalog:dsh",
    "@deepseek-ai/dsh-session-persistence": "catalog:dsh",
    "@deepseek-ai/dsh-session-projection": "catalog:dsh",
    "@deepseek-ai/dsh-skill-filesystem": "catalog:dsh",
    "@deepseek-ai/dsh-tools": "catalog:dsh",
    "@deepseek-ai/dsh-user-approval": "catalog:dsh",
    "@deepseek-ai/dsh-user-questions": "catalog:dsh",
    "@deepseek-ai/dsh-util-code-language": "catalog:dsh",
    "@deepseek-ai/dsh-util-values": "catalog:dsh",
    "@deepseek-ai/dsh-workspace": "catalog:dsh",
    "@deepseek-ai/schemastery": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:types",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "catalog:testing",
    "bumpp": "catalog:cli",
    "eslint": "catalog:cli",
    "publint": "catalog:cli",
    "react": "catalog:",
    "simple-git-hooks": "catalog:cli",
    "skills-npm": "catalog:cli",
    "tsdown": "catalog:cli",
    "tsdown-stale-guard": "catalog:testing",
    "tsnapi": "catalog:testing",
    "tsx": "catalog:cli",
    "typescript": "catalog:cli",
    "vite": "catalog:cli",
    "vitest": "catalog:testing"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm i --frozen-lockfile --ignore-scripts --offline && pnpm run build && pnpm run lint"
  }
}
